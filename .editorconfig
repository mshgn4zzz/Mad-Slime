# Save keys are a serialization contract; never rename these fields on cleanup.
[Assets/MadSlime/Scripts/Saves/Data/SavesYG.cs]
resharper_inconsistent_naming_highlighting = none
dotnet_naming_rule.private_fields.severity = none
dotnet_naming_rule.static_fields.severity = none
dotnet_diagnostic.SA1300.severity = none

# Input System output is regenerated, and is completely outside this style guide.
[Assets/MadSlime/**/PlayerInputActions.cs]
generated_code = true
resharper_disable_formatter = true
resharper_substitution_for_cleanup_profile = * => skip
dotnet_analyzer_diagnostic.severity = none

[Assets/MadSlime/Scripts/Leaderboards/Adapters/{LeaderboardResponse,LeaderboardPlayerResponse}.cs]
resharper_inconsistent_naming_highlighting = none
dotnet_diagnostic.SA1300.severity = none
